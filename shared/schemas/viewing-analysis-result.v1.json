{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Viewing Analysis Result v1",
  "description": "Strict AI return schema for the viewing stage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stage",
    "propertyId",
    "generatedAt",
    "overallRecommendation",
    "summary",
    "topConcerns",
    "missingInformation",
    "suggestedRechecks",
    "dimensionAssessments"
  ],
  "properties": {
    "schemaVersion": {
      "const": "viewing-analysis-result.v1"
    },
    "stage": {
      "const": "viewing"
    },
    "propertyId": {
      "$ref": "#/$defs/id"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "overallRecommendation": {
      "type": "string",
      "enum": [
        "continue_considering",
        "recheck_before_decision",
        "reject"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "topConcerns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concernItem"
      }
    },
    "missingInformation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "suggestedRechecks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dimensionAssessments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comfort",
        "hiddenCosts",
        "hygieneHealth",
        "safety",
        "informationCompleteness"
      ],
      "properties": {
        "comfort": {
          "$ref": "#/$defs/viewingDimension"
        },
        "hiddenCosts": {
          "$ref": "#/$defs/viewingDimension"
        },
        "hygieneHealth": {
          "$ref": "#/$defs/viewingDimension"
        },
        "safety": {
          "$ref": "#/$defs/viewingDimension"
        },
        "informationCompleteness": {
          "$ref": "#/$defs/viewingDimension"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "positive",
        "mixed",
        "risk",
        "unknown"
      ]
    },
    "concernItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "severity",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "relatedViewingId": {
          "$ref": "#/$defs/id"
        },
        "relatedChecklistResultIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "relatedMediaAssetIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "viewingDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "summary"
      ],
      "properties": {
        "level": {
          "$ref": "#/$defs/level"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
